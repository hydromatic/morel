 *
 * Morel without the Spark adapter, as on JDK 11: connecting to a
 * server fails with a message that says so, and the offline
 * connection works.
 *)
(*) requires: no-spark-adapter

Spark.connect "sc://localhost:15002";
> uncaught exception Spark [Spark: CONNECTION: The Spark adapter is not available; it needs JDK 17 or later and the 'spark' Maven profile]
>   raised at: stdIn:1.1-1.37

(*) The offline connection needs no adapter.
val spark = Spark.connect "mock:";
> val spark = {catalog={},connection=<connection mock:>}
>   : {catalog:{...}, connection:connection, ...}
spark.catalog.scott.depts;
> val it =
>   [{deptno=10,dname="ACCOUNTING",loc="NEW YORK"},
>    {deptno=20,dname="RESEARCH",loc="DALLAS"},
>    {deptno=30,dname="SALES",loc="CHICAGO"},
>    {deptno=40,dname="OPERATIONS",loc="BOSTON"}]
>   : {deptno:int, dname:string, loc:string} bag

(*) End spark-disabled.smli
