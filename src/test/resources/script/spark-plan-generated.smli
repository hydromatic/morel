>           direction: SORT_DIRECTION_ASCENDING
>           null_ordering: SORT_NULLS_FIRST
>         }
>         is_global: true
>       }
>     }
>     limit: 3
>   }
> }|_} : string

(*) Query 5: correlated exists subquery.
(spark.connection.prepare (fn () =>
  from d in spark.catalog.scott.depts
    where (exists e in spark.catalog.scott.emps
           where e.deptno = d.deptno andalso e.job = "CLERK")
    yield d.dname
)).toString ();
> val it =
>   {_|
> root {
>   common {
>     plan_id: 0
>   }
>   project {
>     input {
>       common {
>         plan_id: 1
>       }
>       with_relations {
>         root {
>           common {
>             plan_id: 2
>           }
>           filter {
>             input {
>               common {
>                 plan_id: 3
>               }
>               subquery_alias {
>                 input {
>                   common {
>                     plan_id: 4
>                   }
>                   read {
>                     named_table {
>                       unparsed_identifier: "scott.depts"
>                     }
>                   }
>                 }
>                 alias: "d"
>               }
>             }
>             condition {
>               subquery_expression {
>                 plan_id: 5
>                 subquery_type: SUBQUERY_TYPE_EXISTS
>               }
>             }
>           }
>         }
>         references {
>           common {
>             plan_id: 5
>           }
>           filter {
>             input {
>               common {
>                 plan_id: 6
>               }
>               subquery_alias {
>                 input {
>                   common {
>                     plan_id: 7
>                   }
>                   read {
>                     named_table {
>                       unparsed_identifier: "scott.emps"
>                     }
>                   }
>                 }
>                 alias: "e"
>               }
>             }
>             condition {
>               unresolved_function {
>                 function_name: "and"
>                 arguments {
>                   unresolved_function {
>                     function_name: "=="
>                     arguments {
>                       unresolved_attribute {
>                         unparsed_identifier: "e.deptno"
>                         is_metadata_column: false
>                       }
>                     }
>                     arguments {
>                       unresolved_attribute {
>                         unparsed_identifier: "d.deptno"
>                         is_metadata_column: false
>                       }
>                     }
>                   }
>                 }
>                 arguments {
>                   unresolved_function {
>                     function_name: "=="
>                     arguments {
>                       unresolved_attribute {
>                         unparsed_identifier: "e.job"
>                         is_metadata_column: false
>                       }
>                     }
>                     arguments {
>                       literal {
>                         string: "CLERK"
>                       }
>                     }
>                   }
>                 }
>               }
>             }
>           }
>         }
>       }
>     }
>     expressions {
>       unresolved_attribute {
>         unparsed_identifier: "d.dname"
>         is_metadata_column: false
>       }
>     }
>   }
> }|_} : string

(*) Query 6: order, skip, take, then project.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    order e.empno
    skip 2
    take 3
    yield {e.empno, e.ename}
)).toString ();
