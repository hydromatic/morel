>                 input {
>                   common {
>                     plan_id: 4
>                   }
>                   read {
>                     named_table {
>                       unparsed_identifier: "scott.emps"
>                     }
>                   }
>                 }
>                 alias: "e"
>               }
>             }
>             expressions {
