 * The corpus of spark.smli, each query prepared on the offline
 * connection and its Spark plan printed, and nothing else: the
 * PySpark client writes this file too, so that the plans can be
 * compared with the ones Spark itself builds. Do not edit by hand;
 * see the header of spark/capture.py, spark-plan.smli for what else
 * prepare does, and docs/script-format.md.
 *)
(*) requires: spark-adapter spark-prepare

(*) A plan is a long string, and is printed whole.
Sys.set ("stringDepth", NONE);
> val it = () : unit

val spark = Spark.connect "mock:";
> val spark = {catalog={},connection=<connection mock:>}
>   : {catalog:{...}, connection:connection, ...}

(*) Query 1: filter and project over an inline relation.
(spark.connection.prepare (fn () =>
  from r in [{i = 1, s = "one", b = true, x = 1.5},
             {i = 2, s = "two", b = false, x = 2.5},
             {i = 3, s = "three", b = true, x = 3.5}]
    where r.b andalso r.i > 1
    yield {r.s, y = r.x * 2.0}
)).toString ();
> val it =
>   {_|
> root {
>   common {
>     plan_id: 0
>   }
>   project {
>     input {
>       common {
>         plan_id: 1
>       }
>       filter {
>         input {
>           common {
>             plan_id: 2
>           }
>           subquery_alias {
>             input {
>               common {
>                 plan_id: 3
>               }
>               local_relation {
>                 data: [3 rows]
>                 schema: "{\"fields\":[{\"metadata\":{},\"name\":\"b\",\"nullable\":false,\"type\":\"boolean\"},{\"metadata\":{},\"name\":\"i\",\"nullable\":false,\"type\":\"integer\"},{\"metadata\":{},\"name\":\"s\",\"nullable\":false,\"type\":\"string\"},{\"metadata\":{},\"name\":\"x\",\"nullable\":false,\"type\":\"double\"}],\"type\":\"struct\"}"
>               }
>             }
>             alias: "r"
>           }
>         }
>         condition {
>           unresolved_function {
>             function_name: "and"
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "r.b"
>                 is_metadata_column: false
>               }
>             }
>             arguments {
>               unresolved_function {
>                 function_name: ">"
>                 arguments {
>                   unresolved_attribute {
>                     unparsed_identifier: "r.i"
>                     is_metadata_column: false
>                   }
>                 }
>                 arguments {
>                   literal {
>                     integer: 1
>                   }
>                 }
>               }
>             }
>           }
>         }
>       }
>     }
>     expressions {
>       unresolved_attribute {
>         unparsed_identifier: "r.s"
>         is_metadata_column: false
>       }
>     }
>     expressions {
>       alias {
>         expr {
>           unresolved_function {
>             function_name: "*"
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "r.x"
>                 is_metadata_column: false
>               }
>             }
>             arguments {
>               literal {
>                 double: 2.0
>               }
>             }
>           }
>         }
>         name: "y"
>       }
>     }
>   }
> }|_} : string

(*) Query 2: equijoin.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    join d in spark.catalog.scott.depts on e.deptno = d.deptno
    yield {e.ename, d.dname}
)).toString ();
> val it =
>   {_|
> root {
>   common {
>     plan_id: 0
>   }
>   project {
>     input {
>       common {
>         plan_id: 1
>       }
>       join {
>         left {
>           common {
>             plan_id: 2
>           }
>           subquery_alias {
>             input {
>               common {
>                 plan_id: 3
>               }
>               read {
>                 named_table {
>                   unparsed_identifier: "scott.emps"
>                 }
>               }
>             }
>             alias: "e"
>           }
>         }
>         right {
>           common {
>             plan_id: 4
>           }
>           subquery_alias {
>             input {
>               common {
>                 plan_id: 5
>               }
>               read {
>                 named_table {
>                   unparsed_identifier: "scott.depts"
>                 }
>               }
>             }
>             alias: "d"
>           }
>         }
>         join_condition {
>           unresolved_function {
>             function_name: "=="
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "e.deptno"
>                 is_metadata_column: false
>               }
>             }
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "d.deptno"
>                 is_metadata_column: false
>               }
>             }
>           }
>         }
>         join_type: JOIN_TYPE_INNER
>       }
>     }
>     expressions {
>       unresolved_attribute {
>         unparsed_identifier: "d.dname"
>         is_metadata_column: false
>       }
>     }
>     expressions {
>       unresolved_attribute {
>         unparsed_identifier: "e.ename"
>         is_metadata_column: false
>       }
>     }
>   }
> }|_} : string

(*) Query 3: group by with aggregates.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    group e.deptno
      compute {c = count over (), total = sum over e.sal, top = max over e.sal}
)).toString ();
> val it =
>   {_|
> root {
>   common {
>     plan_id: 0
>   }
>   aggregate {
>     input {
>       common {
>         plan_id: 1
>       }
>       subquery_alias {
>         input {
>           common {
>             plan_id: 2
>           }
>           read {
>             named_table {
>               unparsed_identifier: "scott.emps"
>             }
>           }
>         }
>         alias: "e"
>       }
>     }
>     group_type: GROUP_TYPE_GROUPBY
>     grouping_expressions {
>       unresolved_attribute {
>         unparsed_identifier: "e.deptno"
>         is_metadata_column: false
>       }
>     }
>     aggregate_expressions {
>       alias {
>         expr {
>           unresolved_function {
>             function_name: "count"
>             arguments {
>               literal {
>                 integer: 1
>               }
>             }
>           }
>         }
>         name: "c"
>       }
>     }
>     aggregate_expressions {
>       alias {
>         expr {
>           unresolved_function {
>             function_name: "max"
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "e.sal"
>                 is_metadata_column: false
>               }
>             }
>           }
>         }
>         name: "top"
>       }
>     }
>     aggregate_expressions {
>       alias {
>         expr {
>           unresolved_function {
>             function_name: "sum"
>             arguments {
>               unresolved_attribute {
>                 unparsed_identifier: "e.sal"
>                 is_metadata_column: false
>               }
>             }
>           }
>         }
>         name: "total"
>       }
>     }
>   }
> }|_} : string

(*) Query 4: sort and limit.
(spark.connection.prepare (fn () =>
  from e in spark.catalog.scott.emps
    yield {e.ename, e.sal}
    order (DESC sal, ename)
    take 3
)).toString ();
> val it =
>   {_|
> root {
>   common {
>     plan_id: 0
>   }
>   limit {
>     input {
>       common {
>         plan_id: 1
