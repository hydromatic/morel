 *
 * Unit tests for the built-in `Time` structure, defined
 * by the Standard ML Basis Library.
 *)
Sys.set ("lineWidth", 78);
> val it = () : unit
Sys.set ("printLength", 999);
> val it = () : unit
Sys.set ("stringDepth", ~1);
> val it = () : unit
Sys.set ("timeZone", "UTC");
> val it = () : unit
Sys.set ("now", "2024-01-01T00:00:00Z");
> val it = () : unit

Time;
> val it =
>   {+=fn,-=fn,<=fn,<==fn,>=fn,>==fn,compare=fn,fmt=fn,fromMicroseconds=fn,
>    fromMilliseconds=fn,fromNanoseconds=fn,fromReal=fn,fromSeconds=fn,
>    fromString=fn,now=fn,scan=fn,toMicroseconds=fn,toMilliseconds=fn,
>    toNanoseconds=fn,toReal=fn,toSeconds=fn,toString=fn,zeroTime=0}
>   : {+:time * time -> time, -:time * time -> time, <:time * time -> bool,
>       <=:time * time -> bool, >:time * time -> bool, >=:time * time -> bool,
>       compare:time * time -> order, fmt:int -> time -> string,
>       fromMicroseconds:int -> time, fromMilliseconds:int -> time,
>       fromNanoseconds:int -> time, fromReal:real -> time,
>       fromSeconds:int -> time, fromString:string -> time option,
>       now:unit -> time,
>       scan:('a -> (char * 'a) option) -> 'a -> (time * 'a) option,
>       toMicroseconds:time -> int, toMilliseconds:time -> int,
>       toNanoseconds:time -> int, toReal:time -> real, toSeconds:time -> int,
>       toString:time -> string, zeroTime:time}

Time.zeroTime;
> val it = 0 : time

Time.fromSeconds 1;
> val it = 1000000000 : time

Time.toSeconds (Time.fromSeconds 42);
> val it = 42 : int

(Time.fromSeconds 42).toSeconds ();
> val it = 42 : int

Time.fromMilliseconds 1500;
> val it = 1500000000 : time

Time.toMilliseconds (Time.fromSeconds 2);
> val it = 2000 : int

(Time.fromSeconds 2).toMilliseconds ();
> val it = 2000 : int

Time.fromMicroseconds 1000000;
> val it = 1000000000 : time

Time.toMicroseconds (Time.fromSeconds 1);
> val it = 1000000 : int

(Time.fromSeconds 1).toMicroseconds ();
> val it = 1000000 : int

Time.fromNanoseconds 1000000000;
> val it = 1000000000 : time

Time.toNanoseconds (Time.fromSeconds 1);
> val it = 1000000000 : int

(Time.fromSeconds 1).toNanoseconds ();
> val it = 1000000000 : int

Time.fromReal 1.5;
> val it = 1500000000 : time

Time.toReal (Time.fromReal 2.5);
> val it = 2.5 : real

(Time.fromReal 2.5).toReal ();
> val it = 2.5 : real

Time.toString Time.zeroTime;
> val it = "0.000" : string

Time.zeroTime.toString ();
> val it = "0.000" : string

Time.fmt 0 Time.zeroTime;
> val it = "0" : string

Time.fmt 6 (Time.fromReal 1.5);
> val it = "1.500000" : string

Time.fromString "1.5";
> val it = SOME 1500000000 : time option

Time.fromString "bad";
> val it = NONE : time option

Time.compare (Time.fromSeconds 1, Time.fromSeconds 2);
> val it = LESS : order

Time.compare (Time.fromSeconds 2, Time.fromSeconds 1);
> val it = GREATER : order

Time.compare (Time.fromSeconds 1, Time.fromSeconds 1);
> val it = EQUAL : order

(Time.fromSeconds 1).compare (Time.fromSeconds 2);
> val it = LESS : order

(Time.fromSeconds 2).compare (Time.fromSeconds 1);
> val it = GREATER : order

Time.`+` (Time.fromSeconds 1, Time.fromSeconds 2);
> val it = 3000000000 : time

(Time.fromSeconds 1).`+` (Time.fromSeconds 2);
> val it = 3000000000 : time

Time.`-` (Time.fromSeconds 3, Time.fromSeconds 1);
> val it = 2000000000 : time

(Time.fromSeconds 3).`-` (Time.fromSeconds 1);
> val it = 2000000000 : time

Time.`<` (Time.fromSeconds 1, Time.fromSeconds 2);
> val it = true : bool

(Time.fromSeconds 1).`<` (Time.fromSeconds 2);
> val it = true : bool

Time.`<=` (Time.fromSeconds 1, Time.fromSeconds 1);
> val it = true : bool

(Time.fromSeconds 1).`<=` (Time.fromSeconds 1);
> val it = true : bool

Time.`>` (Time.fromSeconds 2, Time.fromSeconds 1);
> val it = true : bool

(Time.fromSeconds 2).`>` (Time.fromSeconds 1);
> val it = true : bool

Time.`>=` (Time.fromSeconds 2, Time.fromSeconds 1);
> val it = true : bool

(Time.fromSeconds 2).`>=` (Time.fromSeconds 1);
> val it = true : bool

(*) Negative time (one second before epoch)
Time.fromSeconds (~1);
> val it = -1000000000 : time

Time.toSeconds (Time.fromSeconds (~1));
> val it = ~1 : int

Time.toString (Time.fromSeconds (~1));
> val it = "~1.000" : string

(*) Time exception: positive infinity
Time.fromReal Real.posInf;
> uncaught exception Time
>   raised at: stdIn:1.1-1.26

(*) Time exception: negative infinity
Time.fromReal Real.negInf;
> uncaught exception Time
>   raised at: stdIn:1.1-1.26

(*) Time exception: NaN
Time.fromReal (0.0/0.0);
> uncaught exception Time
>   raised at: stdIn:1.1-1.24

(*) Time.now uses the 'now' property (set to 2024-01-01T00:00:00Z above)
Time.now ();
> val it = 1704067200000000000 : time

(* [scan getc strm] reads a decimal number of seconds from a prefix of a
 * character stream, after skipping initial whitespace. The expected values
 * are those of SML/NJ, except where noted; SML/NJ's time has microsecond
 * resolution and unbounded range, whereas Morel's is a 64-bit count of
 * nanoseconds. *)
fun reader s i =
  if i < String.size s then SOME (String.sub (s, i), i + 1) else NONE;
> val reader = fn : string -> int -> (char * int) option
Time.scan;
> val it = fn : ('a -> (char * 'a) option) -> 'a -> (time * 'a) option
Time.scan (reader "1.5") 0;
> val it = SOME (1500000000,3) : (time * int) option
Time.scan (reader "0") 0;
> val it = SOME (0,1) : (time * int) option
Time.scan (reader "123") 0;
> val it = SOME (123000000000,3) : (time * int) option

(* Leading whitespace is skipped, and scanning stops at the first character
 * that cannot be part of the number. *)
Time.scan (reader "  1.5xyz") 0;
> val it = SOME (1500000000,5) : (time * int) option
Time.scan (reader "\t\n 2.25") 0;
> val it = SOME (2250000000,7) : (time * int) option
Time.scan (reader "1.5 ") 0;
> val it = SOME (1500000000,3) : (time * int) option

(*) There is no exponent; scanning stops at the "e".
Time.scan (reader "1.5e3") 0;
> val it = SOME (1500000000,3) : (time * int) option
Time.scan (reader "1e3") 0;
> val it = SOME (1000000000,1) : (time * int) option

(*) A second decimal point ends the number.
Time.scan (reader "1.5.6") 0;
> val it = SOME (1500000000,3) : (time * int) option

(*) The number may be signed with "~", "-" or "+".
Time.scan (reader "~1.5") 0;
> val it = SOME (-1500000000,4) : (time * int) option
Time.scan (reader "-1.5") 0;
> val it = SOME (-1500000000,4) : (time * int) option
Time.scan (reader "+1.5") 0;
> val it = SOME (1500000000,4) : (time * int) option
Time.scan (reader "~0.5") 0;
> val it = SOME (-500000000,4) : (time * int) option

(*) The integer part may be omitted, and may have leading zeros.
Time.scan (reader ".5") 0;
> val it = SOME (500000000,2) : (time * int) option
Time.scan (reader "~.5") 0;
> val it = SOME (-500000000,3) : (time * int) option
Time.scan (reader "  +.5") 0;
> val it = SOME (500000000,5) : (time * int) option
Time.scan (reader "007") 0;
> val it = SOME (7000000000,3) : (time * int) option

(* A decimal point must be followed by at least one digit; if it is not, the
 * whole time is ill-formed, not merely finished. *)
Time.scan (reader "1.") 0;
> val it = NONE : (time * int) option
Time.scan (reader "1.x") 0;
> val it = NONE : (time * int) option
Time.scan (reader ".") 0;
> val it = NONE : (time * int) option

(*) A sign must be followed immediately by the number.
Time.scan (reader "+ 1.5") 0;
> val it = NONE : (time * int) option
Time.scan (reader "~~1") 0;
> val it = NONE : (time * int) option
Time.scan (reader "~") 0;
> val it = NONE : (time * int) option

(*) Nothing to scan.
Time.scan (reader "") 0;
> val it = NONE : (time * int) option
Time.scan (reader "  ") 0;
> val it = NONE : (time * int) option
Time.scan (reader "abc") 0;
> val it = NONE : (time * int) option

(* Morel keeps nanoseconds, so it scans more fractional digits than SML/NJ,
 * which keeps microseconds; digits beyond a nanosecond are discarded. *)
Time.scan (reader "0.000000001") 0;
> val it = SOME (1,11) : (time * int) option
Time.scan (reader "0.123456789012") 0;
> val it = SOME (123456789,14) : (time * int) option
Time.scan (reader "1.999999999999") 0;
> val it = SOME (1999999999,14) : (time * int) option

(* Morel's time is a count of nanoseconds, so a number of seconds that SML/NJ
 * can represent may be too large for Morel. *)
Time.scan (reader "12345678901234567890") 0;
> uncaught exception Time
>   raised at: stdIn:1.1-1.44

(*) End time.smli
