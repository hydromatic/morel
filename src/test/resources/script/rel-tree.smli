 *
 * Conformance suite for the relational tree.
 *
 * `Sys.planOf e` prints the tree that the resolver builds for the
 * expression `e`, which is not evaluated. That text is the
 * cross-implementation contract: morel-rust (#33) and morel-go must
 * print the same text for the same query.
 *
 * Where the answer illustrates the rule -- the element an outer
 * join keeps, the element a scan-less query iterates over -- the
 * query is run too, so that a plan cannot be made to match by
 * building a tree that says the right thing and computes the wrong
 * one.
 *)
Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("stringDepth", NONE);
> val it = () : unit
useSilently "scott.smli";
> [opening scott.smli]
> val it = () : unit

(* ---------------------------------------------------------------- *)
(* Leaves.
 *
 * A leaf is a bare expression and holds no name. The filter above it
 * binds the element, and names its id `i` after the binder.
 *)
Sys.planOf (from i in [1, 2, 3] where i > 1);
> val it = {_|
> filter i [i > 1] : int list
>   [1, 2, 3] : int list
> |_} : string

(* A leaf whose element is a record. The element type is read off the
 * expression, so it is the record type, and a field access prints as
 * `#deptno d`. The type is 41 characters, so it prints as `t[1]` and
 * once in the legend. Each node binds an id of its own, and both are
 * `d`: an id is in scope only in its own node's expressions.
 *)
Sys.planOf (from d in scott.depts where d.deptno > 20 yield d.dname);
> val it =
>   {_|
> project d [#dname d] : string bag
>   filter d [#deptno d > 20] : t$0
>     #depts scott : t$0
>
> t$0 {deptno:int, dname:string, loc:string} bag
> |_} : string

(* A query with no scan iterates over one unit element, which is a
 * visible `[()]` leaf. Run it too: the leaf is the whole of why the
 * answer has one element rather than none.
 *)
from where true yield 1;
> val it = [1] : int list
Sys.planOf (from where true yield 1);
> val it =
>   {_|
> project r [1] : int list
>   filter r [true] : unit list
>     [()] : unit list
> |_} : string

(* ---------------------------------------------------------------- *)
(* Joins.
 *
 * A join concatenates its inputs' components and carries no yield;
 * the projection above it is where the components are named.
 *)
Sys.planOf (
  from d in scott.depts, e in scott.emps
    where e.deptno = d.deptno andalso e.job = "PRESIDENT"
    yield {dname = d.dname, ename = e.ename});
> val it =
>   {_|
> project r [{dname = #dname (#1 r), ename = #ename (#2 r)}] : t$0
>   filter r [#deptno (#2 r) = #deptno (#1 r)
>       andalso #job (#2 r) = "PRESIDENT"] : t$1
>     join d e : t$1
>       #depts scott : t$2
>       #emps scott : t$3
>
> t$0 {dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* Three inputs. Joins nest to the left, and the components stay flat:
 * the element that `r` refers to has three of them, read as `#1`, `#2`, `#3`.
 *)
Sys.planOf (
  from d in scott.depts, e in scott.emps, b in scott.bonuses
    where e.deptno = d.deptno andalso b.ename = e.ename
    yield {d.dname, e.ename, b.comm});
> val it =
>   {_|
> project r [{comm = #comm (#3 r),
>     dname = #dname (#1 r),
>     ename = #ename (#2 r)}] : t$0
>   filter r [#deptno (#2 r) = #deptno (#1 r)
>       andalso #ename (#3 r) = #ename (#2 r)] : t$1
>     join r b : t$1
>       join d e : t$2
>         #depts scott : t$3
>         #emps scott : t$4
>       #bonuses scott : t$5
>
> t$0 {comm:real, dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} * {comm:real, ename:string, job:string, sal:real}) bag
> t$2 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$3 {deptno:int, dname:string, loc:string} bag
> t$4 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> t$5 {comm:real, ename:string, job:string, sal:real} bag
> |_} : string

(* A scan that reads an earlier binder is a join carrying a binder,
 * which its right input reads.
 *)
Sys.planOf (
  from d in scott.depts,
      e in (from e2 in scott.emps where e2.deptno = d.deptno)
    yield {d.dname, e.ename});
> val it =
>   {_|
> project r [{dname = #dname (#1 r), ename = #ename (#2 r)}] : t$0
>   join d e : t$1
>     #depts scott : t$2
>     filter e2 [#deptno e2 = #deptno d] : t$3
>       #emps scott : t$3
>
> t$0 {dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* Each node's header lists the ids it binds, named after the binders
 * whose collections they range over: the join binds `d` and `e`, the
 * filter binds `e`. The right input reads `d`, the join's left id,
 * which makes the join dependent. No binder names the join's pair, so
 * the projection calls its id `r`.
 *)
Sys.planOf (
  from d in scott.depts,
      e in (from e in scott.emps where e.deptno = d.deptno)
    yield {d.dname, e.ename});
> val it =
>   {_|
> project r [{dname = #dname (#1 r), ename = #ename (#2 r)}] : t$0
>   join d e : t$1
>     #depts scott : t$2
>     filter e [#deptno e = #deptno d] : t$3
>       #emps scott : t$3
>
> t$0 {dname:string, ename:string} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real}) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* An independent join binds two ids, and its condition reads both. A
 * union binds no id, and each of its inputs binds its own `e`; as
 * each is in scope only in its own node, none needs a suffix.
 *)
from e in (from e in scott.emps where e.job = "MANAGER"
      union distinct (from e in scott.emps where e.deptno = 10)),
    d in scott.depts on e.deptno = d.deptno
  yield {d.dname, e.ename};
> dname      ename
> ---------- ------
> RESEARCH   JONES
> SALES      BLAKE
> ACCOUNTING CLARK
> ACCOUNTING KING
> ACCOUNTING MILLER
>
> val it : {dname:string, ename:string} bag
Sys.planOf (
  from e in (from e in scott.emps where e.job = "MANAGER"
        union distinct (from e in scott.emps where e.deptno = 10)),
      d in scott.depts on e.deptno = d.deptno
    yield {d.dname, e.ename});
> val it =
>   {_|
> project r [{dname = #dname (#2 r), ename = #ename (#1 r)}] : t$0
>   join e d [#deptno e = #deptno d] : t$1
>     union : t$2
>       filter e [#job e = "MANAGER"] : t$2
>         #emps scott : t$2
>       filter e [#deptno e = 10] : t$2
>         #emps scott : t$2
>     #depts scott : t$3
>
> t$0 {dname:string, ename:string} bag
> t$1 ({comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} * {deptno:int, dname:string, loc:string}) bag
> t$2 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> t$3 {deptno:int, dname:string, loc:string} bag
> |_} : string

(* An id is never called the same as a variable that occurs in its
 * scope. Here the projection's id would be `r`, but the projection
 * reads the variable `r`, so the id is `r_1`.
 *)
val r = 5;
> val r = 5 : int
Sys.planOf (from x in [1, 2], y in [3, 4] yield x + y + r);
> val it =
>   {_|
> project r_1 [#1 r_1 + #2 r_1 + r] : int list
>   join x y : (int * int) list
>     [1, 2] : int list
>     [3, 4] : int list
> |_} : string

(* ---------------------------------------------------------------- *)
(* Outer joins.
 *
 * The absent side's components are each wrapped in `option` on their
 * own, not the element as a whole. Run it too: the
 * OPERATIONS row, which has no employee, is what the wrapping is for.
 *)
from d in scott.depts
  left join e in scott.emps on e.deptno = d.deptno
  yield {d.dname, who = e?.ename};
> dname      who
> ---------- ------
> ACCOUNTING CLARK
> ACCOUNTING KING
> ACCOUNTING MILLER
> RESEARCH   SMITH
> RESEARCH   JONES
> RESEARCH   SCOTT
> RESEARCH   ADAMS
> RESEARCH   FORD
> SALES      ALLEN
> SALES      WARD
> SALES      MARTIN
> SALES      BLAKE
> SALES      TURNER
> SALES      JAMES
> OPERATIONS
>
> val it : {dname:string, who:string option} bag
Sys.planOf (
  from d in scott.depts
    left join e in scott.emps on e.deptno = d.deptno
    yield {d.dname, who = e?.ename});
> val it =
>   {_|
> project r [{dname = #dname (#1 r), who = #map Option #ename (#2 r)}] : t$0
>   join d e [left] [#deptno e = #deptno d] : t$1
>     #depts scott : t$2
>     #emps scott : t$3
>
> t$0 {dname:string, who:string option} bag
> t$1 ({deptno:int, dname:string, loc:string} * {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option) bag
> t$2 {deptno:int, dname:string, loc:string} bag
> t$3 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* A right join makes the *left* side's components optional. *)
Sys.planOf (
  from e in (from x in scott.emps where x.job = "PRESIDENT")
    right join d in scott.depts on e.deptno = d.deptno
    yield {d.dname, who = e?.ename});
> val it =
>   {_|
> project r [{dname = #dname (#2 r), who = #map Option #ename (#1 r)}] : t$0
>   join e d [right] [#deptno e = #deptno d] : t$1
>     filter x [#job x = "PRESIDENT"] : t$2
>       #emps scott : t$2
>     #depts scott : t$3
>
> t$0 {dname:string, who:string option} bag
> t$1 ({comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option * {deptno:int, dname:string, loc:string}) bag
> t$2 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> t$3 {deptno:int, dname:string, loc:string} bag
> |_} : string

(* A full join makes both sides optional. *)
from e in (from x in scott.emps where x.job = "PRESIDENT")
  full join d in scott.depts on e.deptno = d.deptno
  yield {dname = d?.dname, who = e?.ename};
> dname      who
> ---------- ----
> ACCOUNTING KING
> RESEARCH
> SALES
> OPERATIONS
>
> val it : {dname:string option, who:string option} bag
Sys.planOf (
  from e in (from x in scott.emps where x.job = "PRESIDENT")
    full join d in scott.depts on e.deptno = d.deptno
    yield {dname = d?.dname, who = e?.ename});
> val it =
>   {_|
> project r [{dname = #map Option #dname (#2 r),
>     who = #map Option #ename (#1 r)}] : t$0
>   join e d [full] [#deptno e = #deptno d] : t$1
>     filter x [#job x = "PRESIDENT"] : t$2
>       #emps scott : t$2
>     #depts scott : t$3
>
> t$0 {dname:string option, who:string option} bag
> t$1 ({comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} option * {deptno:int, dname:string, loc:string} option) bag
> t$2 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> t$3 {deptno:int, dname:string, loc:string} bag
> |_} : string

(* ---------------------------------------------------------------- *)
(* Group, order, set operators.
 *
 * `group` builds a record of its keys and aggregates.
 *)
Sys.planOf (
  from e in scott.emps
    group {e.deptno}
    compute {c = count over (), total = sum over e.sal});
> val it =
>   {_|
> group e [deptno = #deptno e] [c = count over (), total = sum over #sal e] : t$0
>   #emps scott : t$1
>
> t$0 {c:int, deptno:int, total:real} bag
> t$1 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* An aggregate over a list, where the aggregate function takes a bag,
 * is composed with a converter, and the composed function's parameter
 * is a generated name like any other binder. `group` with no keys
 * yields one element, from any number of input elements, including none. *)
Sys.planOf (from i in [1, 2] group {} compute {c = count over ()});
> val it =
>   {_|
> group i [] [c = fn col$0 => count (#fromList Bag col$0) over ()] : {c:int} list
>   [1, 2] : int list
> |_} : string
from i in [] group {} compute {c = count over ()};
> c
> -
> 0
>
> val it : {c:int} list

(* `order` is a sort, and it changes the kind: its input is a `bag`
 * and its output a `list`. `skip` and `take` are nodes of their own,
 * whose arguments are evaluated before the first element and so cannot
 * mention the id.
 *)
Sys.planOf (
  from e in scott.emps order e.sal skip 2 take 3 yield e.ename);
> val it =
>   {_|
> project e [#ename e] : string list
>   take [3] : t$0
>     skip [2] : t$0
>       sort e [#sal e] : t$0
>         #emps scott : t$1
>
> t$0 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} list
> t$1 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string

(* A set operator carries whether it removes duplicates. *)
Sys.planOf (from i in [1, 2] union [3]);
> val it = {_|
> union [all] : int list
>   [1, 2] : int list
>   [3] : int list
> |_} : string
Sys.planOf (from i in [1, 2] except [1]);
> val it = {_|
> except [all] : int list
>   [1, 2] : int list
>   [1] : int list
> |_} : string
Sys.planOf (from i in [1, 2] intersect [2, 3]);
> val it =
>   {_|
> intersect [all] : int list
>   [1, 2] : int list
>   [2, 3] : int list
> |_} : string
from i in [1, 2] intersect [2, 3];
> val it = [2] : int list

(* `unorder` forgets the order of a list and yields a bag. It is a node
 * of its own; nothing here moves it, so it stands above the sort. *)
Sys.planOf (from i in [3, 1, 2] order i unorder);
> val it =
>   {_|
> unorder : int bag
>   sort i [i] : int list
>     [3, 1, 2] : int list
> |_} : string

(* ---------------------------------------------------------------- *)
(* Generated binders.
 *
 * Two nested trees side by side share the enclosing text's numbering:
 * both say `v$0`, because both are bound by the same `let`. An
 * implementation that numbered per tree would say `v$0` and `v$1`.
 *)
val pairs = [(1, 2), (2, 3)];
> 1 2
> - -
> 1 2
> 2 3
>
> val pairs : (int * int) list
Sys.planOf (
  from x in [1, 2, 3]
    where Relational.nonEmpty (from (a, b) in pairs where a = x)
      andalso Relational.nonEmpty (
        from (c, d) in pairs where d = x + 1)
    yield x);
> val it =
>   {_|
> filter x [let
>       val v$0 = x
>     in
>       #nonEmpty Relational (r$0[v$0]) andalso #nonEmpty Relational (r$1[v$0])
>     end] : int list
>   [1, 2, 3] : int list
>
> r$0[v$0] =
>   project r [{a = #1 r, b = #2 r}] : {a:int, b:int} list
>     filter r [#1 r = v$0] : (int * int) list
>       pairs : (int * int) list
>
> r$1[v$0] =
>   project r [{c = #1 r, d = #2 r}] : {c:int, d:int} list
>     filter r [#2 r = v$0 + 1] : (int * int) list
>       pairs : (int * int) list
> |_} : string

(* A tree nested *inside* another nested tree is what produces a
 * second generated binder: `v$0` names the outer element, `v$1` the middle
 * one, and the innermost filter reads `v$1` to compare `c` with `b`.
 *
 * It is the case an implementation is most likely to get wrong. One
 * that builds its text by concatenating strings its children returned
 * restarts the numbering in each child, says `v$0` in both places, and
 * gets it wrong silently.
 *)
from x in [1, 2, 3]
  where Relational.nonEmpty (
    from (a, b) in pairs
      where a = x
        andalso Relational.nonEmpty (
          from (c, d) in pairs where c = b))
  yield x;
> val it = [1] : int list
Sys.planOf (
  from x in [1, 2, 3]
    where Relational.nonEmpty (
      from (a, b) in pairs
        where a = x
          andalso Relational.nonEmpty (
            from (c, d) in pairs where c = b))
    yield x);
> val it =
>   {_|
> filter x [let val v$0 = x in #nonEmpty Relational (r$0[v$0]) end] : int list
>   [1, 2, 3] : int list
>
> r$0[v$0] =
>   project r [{a = #1 r, b = #2 r}] : {a:int, b:int} list
>     filter r [let
>           val v$1 = r
>         in
>           #1 r = v$0 andalso #nonEmpty Relational (r$1[v$1])
>         end] : (int * int) list
>       pairs : (int * int) list
>
> r$1[v$1] =
>   project r [{c = #1 r, d = #2 r}] : {c:int, d:int} list
>     filter r [#1 r = #2 v$1] : (int * int) list
>       pairs : (int * int) list
> |_} : string

(* A prefix operator is written before its one operand, and `~` binds
 * more tightly than any binary operator, so `~x + 1` needs no
 * parentheses and `~(x + 1)` keeps them. A negation of a literal folds
 * before anything prints it, so these negate a variable. *)
Sys.planOf (from i in [1, 2, 3] yield ~i);
> val it = {_|
> project i [~ i] : int list
>   [1, 2, 3] : int list
> |_} : string
Sys.planOf (from i in [1, 2, 3] yield op ~ i);
> val it = {_|
> project i [~ i] : int list
>   [1, 2, 3] : int list
> |_} : string
Sys.planOf (from i in [1, 2, 3] yield ~ (i + 1));
> val it = {_|
> project i [~ (i + 1)] : int list
>   [1, 2, 3] : int list
> |_} : string
Sys.planOf (from i in [1, 2, 3] yield ~i + 1);
> val it = {_|
> project i [~ i + 1] : int list
>   [1, 2, 3] : int list
> |_} : string
Sys.planOf (from i in [1, 2, 3] where ~i < 0);
> val it = {_|
> filter i [~ i < 0] : int list
>   [1, 2, 3] : int list
> |_} : string
from i in [1, 2, 3] yield ~i;
> val it = [~1,~2,~3] : int list

(* The text depends on the query and nothing else.
 *
 * A node's patterns take their ordinals from a counter that runs across
 * everything compiled before, and a binder inside a type reaches the
 * writer as text; both are numbered by the printer, by first occurrence.
 * No test can see a slip from a cold counter, where the allocated name
 * and the printed one coincide -- so this one moves the counter on
 * first, and the two plans below must be the same text. The query reads
 * `ordinal`, which the filter binds as a pattern of its own. *)
val es = [{id = 100, name = "Fred", deptno = 10}];
> deptno id  name
> ------ --- ----
>     10 100 Fred
>
> val es : {deptno:int, id:int, name:string} list
Sys.planOf (from e in es order e.deptno where ordinal > 1);
> val it =
>   {_|
> filter e $ordinal [$ordinal > 1] : t$0
>   sort e [#deptno e] : t$0
>     es : t$0
>
> t$0 {deptno:int, id:int, name:string} list
> |_} : string
(* Move the counter on: eight scans allocate eight patterns. *)
from a in es, b in es, c in es, d in es, e in es, f in es, g in es, h in es
  yield 1;
> val it = [1] : int list
Sys.planOf (from e in es order e.deptno where ordinal > 1);
> val it =
>   {_|
> filter e $ordinal [$ordinal > 1] : t$0
>   sort e [#deptno e] : t$0
>     es : t$0
>
> t$0 {deptno:int, id:int, name:string} list
> |_} : string

(* A tree with no node in it is still a tree.
 *
 * A leaf is any collection-valued expression and has no constructor of
 * its own, so a query that translates to a bare expression has a tree,
 * and it prints as a leaf line with its collection type -- the way the
 * leaf of any other tree does. The type and the trailing newline are
 * what tell it apart from an expression that is not a query, which
 * prints as itself. *)
Sys.planOf (from);
> val it = {|[()] : unit list
> |} : string
from;
> val it = [()] : unit list
Sys.planOf (from i in [1, 2, 3]);
> val it = {|[1, 2, 3] : int list
> |} : string
Sys.planOf (from u: unit);
> val it = {|extent "unit" : unit list
> |} : string

(* An expression that is not a query has no tree, and prints as itself:
 * no type, no trailing newline. That is the difference a reader needs,
 * and `List.hd []` above shows the other side of it. *)
Sys.planOf ([1, 2, 3]);
> val it = "[1, 2, 3]" : string

(* ---------------------------------------------------------------- *)
(* Cases a second implementation asked for.
 *
 * `andalso` associates to the right: `a andalso b andalso c` is
 * `a andalso (b andalso c)`, and the text shows no parentheses. An
 * implementation that folds the other way prints `(a andalso b)
 * andalso c`. *)
Sys.planOf (
  from e in scott.emps
    where e.deptno = 10 andalso e.job = "CLERK" andalso e.sal > 1000.0
    yield e.ename);
> val it =
>   {_|
> project e [#ename e] : string bag
>   filter e [#deptno e = 10 andalso #job e = "CLERK"
>       andalso #sal e > 1000.0] : t$0
>     #emps scott : t$0
>
> t$0 {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} bag
> |_} : string
from e in scott.emps
  where e.deptno = 10 andalso e.job = "CLERK" andalso e.sal > 1000.0
  yield e.ename;
> val it = ["MILLER"] : string bag

(* A group with one key and no aggregate builds a record all the same;
 * the query's bare value is a projection above it. *)
Sys.planOf (from i in [1, 2, 3] group i);
> val it =
>   {_|
> project r [#i r] : int list
>   group i [i = i] : {i:int} list
>     [1, 2, 3] : int list
> |_} : string
from i in [1, 2, 3] group i;
> val it = [1,2,3] : int list

(* A leaf is printed as the implementation's own Core expression, so
 * two implementations agree on its text only where their Core agrees
 * on the expression. A range is a call of `Range.flatten` here; an
 * extent prints as `extent` with its type. *)
Sys.planOf (from c in [#"a" ..] where c <= #"d");
> val it =
>   {_|
> filter c [c <= #"d"] : char list
>   #flatten Range ([AT_LEAST #"a"]) : char list
> |_} : string
from c in [#"a" ..] where c <= #"d";
> val it = [#"a",#"b",#"c",#"d"] : char list
Sys.planOf (from i where i elem [1, 2, 3] andalso i > 1);
> val it =
>   {_|
> filter i [i elem [1, 2, 3] andalso i > 1] : int list
>   extent "int" : int list
> |_} : string
from i where i elem [1, 2, 3] andalso i > 1;
> val it = [2,3] : int list

(*) End rel-tree.smli
