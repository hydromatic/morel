 * either express or implied.  See the License for the specific
 * language governing permissions and limitations under the
 * License.
 *
 * Tests checked types, i.e. a 'type' declaration with a
 * 'check' clause.
 *)

Sys.set ("lineWidth", 78);
> val it = () : unit

(* A 'check' clause on a type declaration states a condition that every
 * value of the type satisfies. *)
type nat = int check i => i >= 0;
> type nat = int check i => i >= 0
val n: nat = 5;
> val n = 5 : nat

(*) A clause may be repeated; each adds a constraint.
type batchSize = int check i => i >= 1 check j => j <= 12;
> type batchSize = int check i => i >= 1 check j => j <= 12

(*) The match may have more than one branch, and need not be exhaustive.
type badPair = (bool * int) check
    (true, 0) => true
  | (false, i) => i mod 2 = 0;
> type badPair = bool * int check (true, 0) => true | (false, i) => i mod 2 = 0

(*) The value the match binds may be destructured.
type parityPair = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parityPair = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2

(*) A type without a clause is unaffected.
type plain = int;
> type plain = int
val p: plain = 5;
> val p = 5 : plain

(* A clause must be a function from the type it constrains to 'bool'. The
 * condition sees the type as the type it abbreviates: the value has not yet
 * been admitted to the checked type, so the constraint may not be assumed
 * of it. *)
type notBool = int check i => i + 1;
> stdIn:1.1-1.36 Error: Cannot deduce type: conflict: bool vs int
>   raised at: stdIn:1.1-1.36
type notInt = int check s => String.size s > 0;
> stdIn:1.1-1.47 Error: Cannot deduce type: conflict: int vs string
>   raised at: stdIn:1.1-1.47

(* The branches of a clause are alternatives, but separate clauses are
 * conjoined, so the two may not be flattened into one list. Here the first
 * clause is total via its second branch; as separate clauses neither would
 * be. *)
type evenOrZero = int check 0 => true | i => i mod 2 = 0 check i => i >= 0;
> type evenOrZero = int check 0 => true | i => i mod 2 = 0 check i => i >= 0

(* A constraint is part of the type's identity, so redeclaring the name with a
 * different condition gives a different type; but it does not survive into
 * the type the compiler works with, so a checked type still behaves as
 * the type it abbreviates. *)
type nat = int check i => i >= 1;
> type nat = int check i => i >= 1
val n2: nat = 5;
> val n2 = 5 : nat
n2 + 1;
> val it = 6 : int
List.hd [n2];
> val it = 5 : nat
List.map (fn i => i) [n2];
> val it = [5] : nat list

(* The name means the declaration in force, at every site that claims it.
 * A type is cached by the name an annotation writes it as, and the cache
 * went on answering with the type the name used to have, so a value was
 * checked against the condition of a type the name no longer meant. 0 is a
 * 'nat' by the first declaration and not by this one. *)
val n3: nat = 0;
> uncaught exception Constraint [0 is not a valid nat]
>   raised at: stdIn:1.5-1.16
0 as nat;
> uncaught exception Constraint [0 is not a valid nat]
>   raised at: stdIn:1.1-1.9
0 asOpt nat;
> val it = NONE : nat option

(* A condition must be closed: it may refer only to the value it is given and
 * to the standard basis. That is what lets a checked type be interned like
 * any other type -- two checked types are the same type when their
 * conditions are textually equal, which would not follow if a condition could
 * also depend on an environment -- and it settles what a condition means when
 * the values it used are re-bound, by making the question not arise.
 *
 * Supporting a non-closed condition, by inlining what it refers to at the
 * declaration so that the condition becomes closed, is a possible future
 * feature; then the type would survive, with the values it used snapshotted
 * as they were when it was declared. *)
val limit = 12;
> val limit = 12 : int
fun lessThanDozen i = i >= 1 andalso i <= limit;
> val lessThanDozen = fn : int -> bool
type batch = int check i => lessThanDozen i;
> stdIn:1.1-1.17 Error: condition of checked type 'batch' is not closed; it refers to 'lessThanDozen'
>   raised at: stdIn:1.1-1.17

(*) Written out, the same condition is closed.
type batch = int check i => i >= 1 andalso i <= 12;
> type batch = int check i => i >= 1 andalso i <= 12
val six: batch = 6;
> val six = 6 : batch

(*) A reference to the standard basis is closed; a built-in is not re-bindable.
type nonEmpty = string check s => String.size s > 0;
> type nonEmpty = string check s => #size String s > 0
val hi: nonEmpty = "hi";
> val hi = "hi" : nonEmpty
val blank: nonEmpty = "";
> uncaught exception Constraint ["" is not a valid nonEmpty]
>   raised at: stdIn:1.5-1.25

(*) A parameterized type may not be checked.
type 'a myList = 'a list check l => not (List.null l);
> stdIn:1.6-1.25 Error: cannot check parameterized type 'myList'
>   raised at: stdIn:1.6-1.25

(* A binding at a checked type is where a value flows into a claim, so the
 * condition is checked there. It is not checked anywhere else: the value is
 * already known to satisfy it. *)
val ok: nat = 5;
> val ok = 5 : nat
val notOk: nat = ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.20

(*) Every clause must hold.
val small: batchSize = 6;
> val small = 6 : batchSize
val tooBig: batchSize = 13;
> uncaught exception Constraint [13 is not a valid batchSize]
>   raised at: stdIn:1.5-1.27
val tooSmall: batchSize = 0;
> uncaught exception Constraint [0 is not a valid batchSize]
>   raised at: stdIn:1.5-1.28

(*) The whole value is quoted in the message, however big.
val evens: parityPair = {i = 2, j = 4};
> val evens = {i=2,j=4} : parityPair
val mixed: parityPair = {i = 1, j = 2};
> uncaught exception Constraint [{i=1,j=2} is not a valid parityPair]
>   raised at: stdIn:1.5-1.39

(* A condition need not match every value; a value it does not match does not
 * satisfy it. Without this the condition would raise 'Match'. *)
type zero = int check 0 => true;
> type zero = int check 0 => true
val z0: zero = 0;
> val z0 = 0 : zero
val z1: zero = 1;
> uncaught exception Constraint [1 is not a valid zero]
>   raised at: stdIn:1.5-1.17

(* 'as' converts a value to a type, checking the type's condition; 'asOpt'
 * tests the condition instead, giving SOME if it holds and NONE if it does
 * not. A conversion displays the type it was asked for, not the type
 * inference deduces: inference gives the meet, which for a checked type is
 * the type it abbreviates, and the conversion is the record of what was
 * verified. 'asOpt' wraps that type in 'option'. *)
val i = 5;
> val i = 5 : int
val j = ~5;
> val j = ~5 : int
i as nat;
> val it = 5 : nat
j as nat;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.9
i asOpt nat;
> val it = SOME 5 : nat option
j asOpt nat;
> val it = NONE : nat option

(* The type survives into a binding, and is the element type of a list of
 * conversions, so what a conversion verified is not lost at the next step. *)
val n = i as nat;
> val n = 5 : nat
val ns = [i as nat, 0];
> val ns = [5,0] : nat list
val no = i asOpt nat;
> val no = SOME 5 : nat option

(*) Converting to an unchecked type claims nothing, and cannot fail.
i as int;
> val it = 5 : int
j asOpt int;
> val it = SOME ~5 : int option

(*) They bind as loosely as ':', so the whole expression is converted.
i - 1 as nat;
> val it = 4 : nat
(i as nat) + 1;
> val it = 6 : int
i - 10 as nat;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.14

(* They are left-associative, and mix with ':'. The last conversion is the
 * one that decides the type, so 'i as nat as int' is an 'int'. *)
i as nat as int;
> val it = 5 : int
(i : int) as nat;
> val it = 5 : nat

(* Every conversion in a chain is checked, so widening at the end does not
 * excuse a narrowing before it that fails. The position blames the
 * conversion that raised, not the whole expression. *)
~1 as nat as int;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.1-1.10

(* A conversion between types with different erasures is an ordinary type
 * error, reported by the unifier without any constraint reasoning. *)
"abc" as nat;
> stdIn:1.1-1.13 Error: Cannot deduce type: conflict: nat (alias for int) vs string
>   raised at: stdIn:1.1-1.13

(* A parameter's check is compiled inside the function, so it travels with
 * the function value and fires however the function is called. The position
 * reported is the function's, not the call's, for that reason. *)
fun f (n: nat) = n;
> val f = fn : nat -> nat
f 5;
> val it = 5 : int
f ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.19
val k = fn (n: nat) => n + 1;
> val k = fn : int -> int
k ~3;
> uncaught exception Constraint [~3 is not a valid nat]
>   raised at: stdIn:1.12-1.29

(* So a checked value may be passed through a polymorphic function that
 * knows nothing of the constraint, and is still checked. This is why such a
 * function needs no reified type or handler. *)
List.map f [1, 2];
> val it = [1,2] : int list
List.map f [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat]
>   raised at: stdIn:1.5-1.19
List.filter (fn i => i > 0) [1, ~2];
> val it = [1] : int list

(* The annotation is read, not deduced, because the body may weaken it:
 * arithmetic drops the constraint, so this function's type is 'int -> int',
 * but its parameter is still checked. *)
fun decr (n: nat) = n - 1;
> val decr = fn : int -> int
decr 3;
> val it = 2 : int
decr ~3;
> uncaught exception Constraint [~3 is not a valid nat]
>   raised at: stdIn:1.5-1.26

(* What drops the constraint is the operator, not the operands. 'n - 1' loses
 * it because the '1' is an 'int' that the 'nat' has to meet, and a meet takes
 * the weaker of the two; but an operator applied to operands of its own type
 * has nothing to meet. Such an operator computes a value the type has not
 * been shown to contain, so it drops the constraint whatever it was applied
 * to, and a unary operator drops it too. *)
~n2;
> val it = ~5 : int
n2 + n2;
> val it = 10 : int
abs n2;
> val it = 5 : int
type small = int check i => i < 100;
> type small = int check i => i < 100
val s: small = 60;
> val s = 60 : small
s + s;
> val it = 120 : int
s * s;
> val it = 3600 : int
fun dbl (i: small) = i + i;
> val dbl = fn : int -> int
dbl 60;
> val it = 120 : int

(* A check is made where the value flows into the claim, whatever the body
 * then does with the name it binds. Raising is a check's only effect, so an
 * optimizer that reasons about values alone would be entitled to discard one
 * whose name is never read, or to defer one to wherever its name is read;
 * either would lose the check. *)
fun ignores (i: nat) = 0;
> val ignores = fn : nat -> int
ignores 5;
> val it = 0 : int
ignores ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.25

(*) Read only in a branch that is not taken.
fun branches (i: nat) = if false then i else 0;
> val branches = fn : int -> int
branches ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.5-1.47

(*) Read only inside a function that is never called.
val delays = fn (i: nat) => fn () => i;
> val delays = fn : nat -> unit -> nat
delays ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.17-1.39

(* A claim on a composite type is a claim about its components, so each is
 * checked. The message names the component that failed and quotes it, rather
 * than the whole value. A tuple's components are numbered as its selectors
 * are, so 'component 2' is what '#2' selects. An element is written '[_]',
 * a subscript with nothing known about which element it was; if a collection
 * ever declares a key, that is where the key would go. *)
type employee = {empno: nat, name: string};
> type employee = {empno:nat, name:string}
val e: employee = {empno = 1, name = "Fred"};
> val e = {empno=1,name="Fred"} : employee
val e2: employee = {empno = ~1, name = "Fred"};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.5-1.47

(*) Nesting is followed to any depth.
type team = {lead: employee, size: nat};
> type team = {lead:employee, size:nat}
val t: team = {lead = {empno = ~1, name = "Fred"}, size = 2};
> uncaught exception Constraint [~1 is not a valid nat: field lead.empno]
>   raised at: stdIn:1.5-1.61

(*) A tuple behaves as a record does.
type pair = nat * nat;
> type pair = nat * nat
val p: pair = (1, 2);
> val p = (1,2) : pair
val p2: pair = (1, ~2);
> uncaught exception Constraint [~2 is not a valid nat: component 2]
>   raised at: stdIn:1.5-1.23

(*) Every element of a list must satisfy the element type's condition.
type nats = nat list;
> type nats = nat list
val ns: nats = [1, 2];
> val ns = [1,2] : nats
val ns2: nats = [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat: [_]]
>   raised at: stdIn:1.5-1.24

(* A vector is walked element by element, as a list is. It is not a
 * collection -- a query cannot scan one -- and it is an eqtype, so it has no
 * constructors to walk either; before this it fell between the two, and a
 * condition inside one was claimed and never checked. *)
type natVector = nat vector;
> type natVector = nat vector
val vs: natVector = Vector.fromList [1, 2];
> val vs = #[1,2] : natVector
val vs2: natVector = Vector.fromList [1, ~2];
> uncaught exception Constraint [~2 is not a valid nat: [_]]
>   raised at: stdIn:1.5-1.45

(* The claim is reached through whatever encloses the vector: a walk that
 * answers "nothing here is checked" is believed by every walk above it. *)
val vs3: nat vector list = [Vector.fromList [~1]];
> uncaught exception Constraint [~1 is not a valid nat: [_][_]]
>   raised at: stdIn:1.5-1.50

(*) A vector whose element type constrains nothing is not checked.
val vs4: int vector = Vector.fromList [~1];
> val vs4 = #[~1] : int vector

(* Components are checked before the whole, so a type's own condition may
 * assume that its components satisfy theirs. *)
type nonEmptyNats = nat list check l => not (List.null l);
> type nonEmptyNats = nat list check l => not (#null List l)
val q1: nonEmptyNats = [1];
> val q1 = [1] : nonEmptyNats
val q2: nonEmptyNats = [];
> uncaught exception Constraint [[] is not a valid nonEmptyNats]
>   raised at: stdIn:1.5-1.26
val q3: nonEmptyNats = [~1];
> uncaught exception Constraint [~1 is not a valid nat: [_]]
>   raised at: stdIn:1.5-1.28

(*) A composite that constrains nothing is not checked at all.
type plainPair = int * string;
> type plainPair = int * string
val pp: plainPair = (1, "a");
> val pp = (1,"a") : plainPair

(* The whole is blamed only when its own condition fails; a component that
 * fails is blamed for itself. Components are checked first, so the innermost
 * failure is the one reported. *)
type evenPair = (nat * nat) check (i, j) => i * j mod 2 = 0;
> type evenPair = nat * nat check (i, j) => i * j mod 2 = 0
val ep1: evenPair = (2, 3);
> val ep1 = (2,3) : evenPair
val ep2: evenPair = (~1, 2);
> uncaught exception Constraint [~1 is not a valid nat: component 1]
>   raised at: stdIn:1.5-1.28
val ep3: evenPair = (1, 3);
> uncaught exception Constraint [(1,3) is not a valid evenPair]
>   raised at: stdIn:1.5-1.27

(* Applying a datatype constructor is a construction site, like a binding:
 * the constructor was declared to hold a 'nat', so its argument is checked. *)
datatype box = Box of nat;
> datatype box = Box of nat
Box 1;
> val it = Box 1 : box
Box ~1;
> uncaught exception Constraint [~1 is not a valid nat: argument of Box]
>   raised at: stdIn:1.1-1.4

(*) The path names the component within the argument.
datatype boxPair = BoxPair of nat * nat;
> datatype boxPair = BoxPair of nat * nat
BoxPair (1, ~2);
> uncaught exception Constraint [~2 is not a valid nat: argument of BoxPair.2]
>   raised at: stdIn:1.1-1.8

(*) A constructor that holds an unchecked type is not checked.
datatype plainBox = PlainBox of int;
> datatype plainBox = PlainBox of int
PlainBox ~1;
> val it = PlainBox ~1 : plainBox

(* A condition reached through a datatype's type parameter is checked too.
 * The datatype is walked, as a record and a collection are: the value must
 * satisfy whatever the type it was given carries. Without this the claim was
 * made and never checked -- 'nat option' printed, holding a value that is not
 * one. *)
val someNat: nat option = SOME 1;
> val someNat = SOME 1 : nat option
val someNotNat: nat option = SOME ~1;
> uncaught exception Constraint [~1 is not a valid nat: SOME]
>   raised at: stdIn:1.5-1.37

(*) A constructor that carries nothing has nothing to check.
val noNat: nat option = NONE;
> val noNat = NONE : nat option

(*) The same goes for a datatype the user declared.
datatype 'a bx = Bx of 'a;
> datatype 'a bx = Bx of 'a
val bxNat: nat bx = Bx ~1;
> uncaught exception Constraint [~1 is not a valid nat: Bx]
>   raised at: stdIn:1.5-1.26

(* A datatype may contain itself, so the walk is a function that is applied to
 * the value rather than an expansion, and a recursive datatype calls it. The
 * value is checked however deep the condition is reached. *)
datatype 'a tree = Leaf | Node of 'a * 'a tree;
> datatype 'a tree = Leaf | Node of 'a * 'a tree
val goodTree: nat tree = Node (1, Node (2, Leaf));
> val goodTree = Node (1,Node (2,Leaf)) : nat tree
val badTree: nat tree = Node (1, Node (~2, Leaf));
> uncaught exception Constraint [~2 is not a valid nat: Node.1]
>   raised at: stdIn:1.5-1.50

(*) A datatype whose parameter carries no condition is not walked.
val plainTree: int tree = Node (1, Node (~2, Leaf));
> val plainTree = Node (1,Node (~2,Leaf)) : int tree

(* A record modifier that assigns to a field claims the type of the record it
 * modifies -- the field keeps its declared type, so the value must have it --
 * and the claim is checked at the modifier. Nobody else wrote the type down,
 * so nowhere else would check it. *)
{e replace empno = ~1};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.1-1.23
val e3: employee = {e replace empno = ~1};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.20-1.42

(*) A value that satisfies the field's type gives back the type unchanged.
{e replace empno = 2};
> val it = {empno=2,name="Fred"} : employee

(* 'lenient' says the field need not keep its type, so nothing is claimed of
 * the value and nothing is checked. The result is a different type. *)
{e replace lenient empno = ~1};
> val it = {empno=~1,name="Fred"} : {empno:int, name:string}

(* A modifier that adds, removes or renames a field cannot claim the type: the
 * result has a different shape. It needs no check either -- every value it
 * carries over was checked when it was put there. *)
{e extend hired = true};
> val it = {empno=1,hired=true,name="Fred"}
>   : {empno:nat, hired:bool, name:string}
{e remove name};
> val it = {empno=1} : {empno:nat}

(*) 'replace all' assigns too, so it claims and checks.
{e replace all {empno = ~1}};
> uncaught exception Constraint [~1 is not a valid nat: field empno]
>   raised at: stdIn:1.1-1.29
{e replace all {empno = 2}};
> val it = {empno=2,name="Fred"} : employee

(* A verb that skips assigns nothing, so the record is the one it was given,
 * and the type comes back with it. *)
{e replace or skip hired = true};
> val it = {empno=1,name="Fred"} : employee

(* Every modifier in a chain must leave the shape alone; one that does not
 * gives a record the name no longer fits, so the chain claims nothing, and an
 * assigned field takes the type of the value rather than keeping its own.
 * Nothing is claimed of '~1' -- the field it is in is an 'int' -- so nothing
 * is checked, and the type that is printed says so. *)
{e replace empno = 2 extend hired = true};
> val it = {empno=2,hired=true,name="Fred"}
>   : {empno:int, hired:bool, name:string}
{e replace empno = ~1 extend hired = true};
> val it = {empno=~1,hired=true,name="Fred"}
>   : {empno:int, hired:bool, name:string}
{e replace empno = ~1 remove name};
> val it = {empno=~1} : {empno:int}

(* --- A modifier inherits the record's own condition ------------- *)

(* A modifier that changes the record's shape cannot claim its type, but the
 * type's own conditions need not be lost with the name. A condition is
 * carried over if every field it depends on was left alone, and rewritten to
 * name them as the result names them. The result is a checked type that
 * has no name. *)
type crate = {a: int, b: nat} check r => r.a < 10;
> type crate = {a:int, b:nat} check r => #a r < 10
val v0: crate = {a = 1, b = 2};
> val v0 = {a=1,b=2} : crate

(*) 'extend' leaves every field alone, so every condition is carried over.
{v0 extend c = 5};
> val it = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10

(* 'remove' drops a condition that mentions the field it removed -- the
 * condition would no longer typecheck -- and keeps one that does not.
 * Projecting a column away drops the constraints that mention it, as it does
 * in a database. *)
{v0 remove a};
> val it = {b=2} : {b:nat}
{v0 remove b};
> val it = {a=1} : {a:int} check r => #a r < 10

(*) 'rename' carries the condition over with the field renamed inside it.
{v0 rename z = a};
> val it = {b=2,z=1} : {b:nat, z:int} check r => #z r < 10

(* The condition is carried into the type, not just displayed on it, so it is
 * enforced where the derived record is modified again. This is what the
 * inheritance is for: a schema derived by 'extend' keeps its invariants. *)
val v1 = {v0 extend c = 5};
> val v1 = {a=1,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 3};
> val it = {a=3,b=2,c=5} : {a:int, b:nat, c:int} check r => #a r < 10
{v1 replace a = 20};
> uncaught exception Constraint [{a=20,b=2,c=5} is not a valid value]
>   raised at: stdIn:1.1-1.20

(* A condition that depends on a field the modifier assigned to is dropped:
 * the value that is there now was never shown to satisfy it. *)
{v0 replace a = 3 extend c = 1};
> val it = {a=3,b=2,c=1} : {a:int, b:nat, c:int}
{v0 replace b = 3 extend c = 1};
> val it = {a=1,b=3,c=1} : {a:int, b:int, c:int} check r => #a r < 10

(* A condition written by destructuring is rewritten to select instead, so
 * that it holds of a record with fields its pattern does not mention.
 * Otherwise whether a condition could be inherited would depend on how it
 * happened to be written. *)
type parity = {i: int, j: int} check {i, j} => i mod 2 = j mod 2;
> type parity = {i:int, j:int} check {i = i, j = j} => i mod 2 = j mod 2
val p0: parity = {i = 2, j = 4};
> val p0 = {i=2,j=4} : parity
val p1 = {p0 extend k = 1};
> val p1 = {i=2,j=4,k=1}
>   : {i:int, j:int, k:int} check $r => let val i = #i $r and j = #j $r in i mod 2 = j mod 2 end
{p1 replace i = 4};
> val it = {i=4,j=4,k=1}
>   : {i:int, j:int, k:int} check $r => let val i = #i $r and j = #j $r in i mod 2 = j mod 2 end
{p1 replace i = 3};
> uncaught exception Constraint [{i=3,j=4,k=1} is not a valid value]
>   raised at: stdIn:1.1-1.19

(* A condition that uses the record as a whole, rather than by selecting
 * fields from it, is dropped: a record of another shape is not that record. *)
type whole = {i: int, j: int} check r => r = {i = 1, j = 2};
> type whole = {i:int, j:int} check r => r = {i = 1, j = 2}
val w0: whole = {i = 1, j = 2};
> val w0 = {i=1,j=2} : whole
{w0 extend k = 9};
> val it = {i=1,j=2,k=9} : {i:int, j:int, k:int}

(* 'typeof e' names the type 'e' was shown to have, conditions and all, so an
 * annotation that uses it claims what that type claims. It used to reduce the
 * type to what inference made of it, which left the claim unchecked. *)
val fromTypeof: typeof n = 5;
> val fromTypeof = 5 : nat
val fromTypeofBad: typeof n = ~5;
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.5-1.33
(~5 : typeof n);
> uncaught exception Constraint [~5 is not a valid nat]
>   raised at: stdIn:1.1-1.16

(* A condition written on a 'typeof' is not supported. A condition is typed
 * against its base, and the base has to be materialized to do that, which a
 * 'typeof' cannot be at the point a type is converted. A 'typeof' in a type
 * or datatype declaration does work, because there the expression it names
 * can be deduced on its own. *)
(5 : (typeof n check i => i < 100));
> stdIn:1.7-1.15 Error: 'typeof' is not supported here
>   raised at: stdIn:1.7-1.15

(* An ascription is a claim, like a binding, so it is checked wherever it
 * appears -- not only where its value is bound. *)
(~1 : nat);
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.1-1.11
([1, ~2] : nat list);
> uncaught exception Constraint [~2 is not a valid nat: [_]]
>   raised at: stdIn:1.1-1.21
val fm = fn () => (~1 : nat);
> val fm = fn : unit -> int
fm ();
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.19-1.29

(* An ascription inside a binding is checked twice over, and each check walks
 * the bag with a predicate of its own. A check said that it needed no stack
 * slots, which was true of the check and false of the condition inside it, so
 * the predicate was given a frame with no room to evaluate the condition on a
 * field of the element. *)
val twice: {empno: nat} bag = (bag [{empno = 1}] : {empno: nat} bag);
> val twice = [{empno=1}] : {empno:nat} bag

(* A 'fun' declaration's result annotation reaches Resolver as an ascription
 * on the body, so a result is checked too. The declared type is still 'int':
 * the annotation and the body's type meet, and the meet of a checked type
 * and the type it abbreviates is the latter. *)
fun neg () : nat = ~1;
> val neg = fn : unit -> int
neg ();
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.20-1.22
fun pos () : nat = 1;
> val pos = fn : unit -> int
pos ();
> val it = 1 : int
fun idNat (x: int) : nat = x;
> val idNat = fn : int -> int
idNat 1;
> val it = 1 : int
idNat ~1;
> uncaught exception Constraint [~1 is not a valid nat]
>   raised at: stdIn:1.28

(* A check on a value is made when the value is made, and a function value is
 * not a value its type can be checked against: to check 'nat -> nat' every
 * argument it is ever given and every result it ever returns would have to be
 * checked, which means replacing the function with a proxy. Rather than do
 * that silently, or accept the claim and check nothing, the claim is
 * rejected. *)
val h: nat -> nat = fn i => i - 1;
