(* typeof --------------------------------------------------------- *)

(*) Annotations that use 'typeof'
fn x: typeof 1 => true;
> val it = fn : int -> bool

let
  val s = "abc"
in
  fn x: typeof s => [x]
end;
> val it = fn : string -> string list

let
  val list = ["abc", "de"]
in
  fn x: typeof (hd list) => [x]
end;
> val it = fn : string -> string list

let
  val r = {empno = 100, isMgr = true, name = "Fred"};
in
  fn x: typeof r.isMgr => ()
end;
> val it = fn : bool -> unit

let
  val r = {empno = 100, isMgr = true, name = "Fred"};
in
  fn x: typeof r => x.empno
end;
> val it = fn : {empno:int, isMgr:bool, name:string} -> int

let
  val r = {empno = 100, isMgr = true, name = "Fred"};
in
  fn x: {a: string, b: typeof r.empno list, c: typeof (r.name ^ "!")} => ()
end;
> val it = fn : {a:string, b:int list, c:string} -> unit

let
  val rec fact =
    fn n : typeof n =>
      if n = 0 then 1
      else n * fact (n - 1)
in
  fact 5
end;
> stdIn:3.19 Error: unbound variable or constructor: n
>   raised at: stdIn:3.19

val m = 5;
> val m = 5 : int
let
  val rec fact =
    fn n : typeof m =>
      if n = 0 then 1
      else n * fact (n - 1)
in
  fact 5
end;
> val it = 120 : int

(* An annotation on an expression, like one on a pattern, resolves in the
 * environment it appears in. *)
let
  val s = "abc"
in
  (1, s) : typeof (2, s)
end;
> val it = (1,"abc") : int * string

let
  val n = 5
in
  n + 1 : typeof n
end;
> val it = 6 : int

(* A 'typeof' annotation on the expression or the pattern of a value
 * declaration gives the binding the type that is deduced for it. *)
(1, true) : typeof (0, false);
> val it = (1,true) : int * bool
val x : typeof m = 6;
> val x = 6 : int
val y = 6 : typeof m;
> val y = 6 : int
val z = [1] : typeof [m];
> val z = [1] : int list

(* 'typeof e' names the type 'e' was shown to have, so an alias survives it:
 * it does not reduce the type to what inference made of it. *)
type myInt = int;
> type myInt = int
val mi: myInt = 5;
> val mi = 5 : myInt
val mi2: typeof mi = 6;
> val mi2 = 6 : myInt
val mi3 = 6 : typeof mi;
> val mi3 = 6 : myInt

(* A type declaration may use 'typeof'. A name in the body of one refers to
 * the environment before the declaration -- that is what makes 'type t = t'
 * mean "the previous t" -- so the expression cannot mention what the
 * declaration binds, and its type is deduced on its own. *)
type t = typeof mi;
> type t = myInt
val tv: t = 7;
> val tv = 7 : t

(*) The expression need not be a name.
type pair = typeof (1, "a");
> type pair = int * string
val pv: pair = (2, "b");
> val pv = (2,"b") : pair

(*) A datatype constructor's argument type may use it too.
datatype box = BOX of typeof mi;
> datatype box = BOX of myInt
BOX 3;
> val it = BOX 3 : box

(* Deduction may rewrite the expression -- an 'order' step is copied so that
 * its warning can be attached -- so the type is read from the declaration the
 * nested deduction returned, not from the node it was given. *)
type ordered = typeof (from i in [1,2] order {b = i, a = i});
> stdIn:1.46-1.60 Warning: Sorting on a record whose fields are not in alphabetical order. Sort order may not be what you expect.
>   raised at: stdIn:1.46-1.60
> type ordered = int list

(* The expression is deduced once, however many times the declaration asks
 * for its type. A datatype converts a constructor's argument twice, and
 * without memoizing, the warning above would be reported twice. *)
datatype orderedBox = OB of typeof (from i in [1,2] order {b = i, a = i});
> stdIn:1.59-1.73 Warning: Sorting on a record whose fields are not in alphabetical order. Sort order may not be what you expect.
>   raised at: stdIn:1.59-1.73
> datatype orderedBox = OB of int list

(* The rule that a name refers to the environment before the declaration
 * applies here as everywhere, so 'typeof' cannot see what is being
 * declared. *)
type u = typeof nosuchvalue;
> stdIn:1.17-1.28 Error: unbound variable or constructor: nosuchvalue
>   raised at: stdIn:1.17-1.28

(* type_string ---------------------------------------------------- *)
(* The 'type_string' operator renders the inferred type of an expression as
 * a string, without evaluating the expression. *)
type_string (1 + 2);
> val it = "int" : string
type_string (fn x => x);
> val it = "'a -> 'a" : string
type_string String.size;
> val it = "string -> int" : string
type_string [1, 2, 3];
> val it = "int list" : string
type_string {a = 1, b = "x"};
> val it = "{a:int, b:string}" : string

(*) The operand is not evaluated, so this does not raise 'Empty'.
type_string (hd []);
> val it = "'a" : string

(*) Polymorphism is preserved.
type_string (fn (x, y) => x);
> val it = "'a * 'b -> 'a" : string

(* Operand precedence is 9, so a dotted operand needs no parentheses,
 * but an application or infix operator does. *)
val r = {a = 1, b = true};
> val r = {a=1,b=true} : {a:int, b:bool}
type_string r.b;
> val it = "bool" : string
type_string (String.size "hi");
> val it = "int" : string

type_string ("x" ^ "y") ^ "z";
> val it = "stringz" : string

(* The operand has precedence 9 -- an atom and its field selections
 * -- not a whole application, so "type_string f x" is
 * "(type_string f) x", which applies x to the resulting string,
 * rather than the type of "f x". *)
type_string String.size "abc";
> stdIn:1.1-1.30 Error: Cannot deduce type: conflict: T2 -> T0 vs string
>   raised at: stdIn:1.1-1.30

fun foo list = (size list, type_string (true, list));
> val foo = fn : string -> int * string
foo "abc";
> val it = (3,"bool * string") : int * string

fun foo2 s = (size s, type_string (true, s));
> val foo2 = fn : string -> int * string
foo2 "abc";
> val it = (3,"bool * string") : int * string

fun foo3 list = (length list, type_string {b = list, a = 1});
> val foo3 = fn : 'a list -> int * string
foo3 [true, false];
> val it = (2,"{a:int, b:'a list}") : int * string

(* Function with unit arg ----------------------------------------- *)
fun one () = 1;
> val one = fn : unit -> int
one ();
> val it = 1 : int
one {};
> val it = 1 : int
let
  fun one () = 1
in
  one ()
end;
> val it = 1 : int

