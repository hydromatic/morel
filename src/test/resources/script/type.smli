(* When printing a type, 'forall' is omitted. Sometimes that eliminates
 * type variables. The following tests make sure that type variables are
 * contiguous and numbered left-to-right. *)
[[], []];
> val it = [[],[]] : 'a list list
let val r = {a=[], b=[]} in r.b end;
> val it = [] : 'a list
fun f (a, b, c) = {x=c, y=a};
