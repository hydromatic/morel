(*) Constraint after parentheses is on the return type.
fun two_list (x, y): 'a list = [x, y];
> val two_list = fn : 'a * 'a -> 'a list
two_list ("a", "b");
> val it = ["a","b"] : string list

(*) ...even there is only one argument.
fun one_list (x): 'a list = [x];
