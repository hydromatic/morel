>   : string

(* testFromSuchThat2e - Function inlining with elem predicate.
 * As testFromSuchThat2d but using a function. (Simple enough
 * that the function can be handled by inlining. *)
fun isDept d =
  d elem scott.depts;
> val isDept = fn : {deptno:int, dname:string, loc:string} -> bool
from d
  where isDept d andalso d.deptno = 20
  yield d.dname;
> val it = ["RESEARCH"] : string list
Sys.planEx "0";
> val it =
>   "val it = from d : {deptno:int, dname:string, loc:string} where (let val d_1 = d in op elem (d_1, #depts scott) end) andalso #deptno d = 20 yield #dname d"
>   : string
Sys.planEx "999";
> val it =
>   "val it = from d in #toList Bag (#depts scott) group d order d where #deptno d = 20 yield #dname d"
>   : string

(* testFromSuchThat2f - Join via suchthat with two functions *)
let
  fun isDept d =
    d elem scott.depts
  fun isEmp e =
    e elem scott.emps
in
  from d, e
    where isDept d
    andalso isEmp e
    andalso d.deptno = e.deptno
    andalso d.deptno = 20
    yield d.dname
end;
> val it = ["RESEARCH","RESEARCH","RESEARCH","RESEARCH","RESEARCH"]
>   : string list
Sys.planEx "0";
> val it =
>   "val it = let val isDept = fn d => op elem (d, #depts scott) in let val isEmp = fn e => op elem (e, #emps scott) in from d_1 : {deptno:int, dname:string, loc:string} join e_1 : {comm:real, deptno:int, empno:int, ename:string, hiredate:string, job:string, mgr:int, sal:real} where isDept d_1 andalso isEmp e_1 andalso #deptno d_1 = #deptno e_1 andalso #deptno d_1 = 20 yield #dname d_1 end end"
>   : string
Sys.planEx "999";
> val it =
>   "val it = from d in #toList Bag (#depts scott) group d order d join e in (from e in #toList Bag (#emps scott) group e order e) where #deptno d = #deptno e andalso #deptno d = 20 yield #dname d"
>   : string

(* testProvenanceThroughFunction - Provenance propagation through
 * function inversion. When 'f x' appears in WHERE, maybeFunction
 * inlines the body and creates a Collection generator for x. The
 * provenance system adds 'f x' to the generator's provenance,
 * so expandFrom2 can remove it from WHERE. At plan level 999,
 * there is no WHERE clause. *)
let
  val xs = [1, 2, 3]
  fun f x = x elem xs
in
  from x where f x
end;
> val it = [1,2,3] : int list
Sys.planEx "0";
> val it =
>   "val it = let val xs = [1, 2, 3] in let val f = fn x => op elem (x, xs) in from x_1 : int where f x_1 end end"
>   : string
Sys.planEx "999";
> val it = "val it = from x in [1, 2, 3] group x order x" : string

(* testProvenanceThroughFunctionWithFilter - Same as above but
 * with an additional filter. Provenance removes 'f x'
 * but keeps 'x > 1'. *)
let
  val xs = [1, 2, 3]
  fun f x = x elem xs
in
  from x where f x andalso x > 1
end;
> val it = [2,3] : int list
Sys.planEx "0";
> val it =
>   "val it = let val xs = [1, 2, 3] in let val f = fn x => op elem (x, xs) in from x_1 : int where f x_1 andalso x_1 > 1 end end"
>   : string
Sys.planEx "999";
> val it = "val it = from x in [1, 2, 3] group x order x where x > 1" : string

(* testFromSuchThat3 - Smaller version of testFromSuchThat *)
let
  val emps = [
    {id = 102, name = "Shaggy", deptno = 30},
    {id = 103, name = "Scooby", deptno = 30}]
  fun hasEmpNameInDept (n, d) =
    (n, d) elem (from e in emps yield (e.name, e.deptno))
in
  from n, d
    where hasEmpNameInDept (n, d)
    where d = 30
    yield {d, n}
end;
> d  n
> -- ------
> 30 Scooby
