>   "val it = from dno : int join name : string where op elem ({deptno = dno, dname = name, loc = \"CHICAGO\"}, #depts scott) andalso dno > 20"
>   : string
Sys.planEx "3";
> val it =
>   "val it = from ({deptno = dno, dname = name, loc = \"CHICAGO\"}) in #toList Bag (#depts scott) group {dno = dno, name = name} order {dno = dno, name = name} where dno > 20"
>   : string

(* testFromSuchThat2d3 - Forward references with equality constraint *)
from dno, name, v
where v elem scott.depts
where v.deptno = dno
where name = v.dname
where v.loc = "CHICAGO"
where dno = 30
yield {dno = #deptno v, name = #dname v};
> dno name
> --- -----
>  30 SALES
>
> val it : {dno:int, name:string} list
Sys.planEx "0";
> val it =
>   "val it = from dno : int join name : string join v : {deptno:int, dname:string, loc:string} where op elem (v, #depts scott) where #deptno v = dno where name = #dname v where #loc v = \"CHICAGO\" where dno = 30 yield {dno = #deptno v, name = #dname v}"
>   : string
Sys.planEx "3";
> val it =
>   "val it = from v in #toList Bag (#depts scott) group v order v join dno in [#deptno v] join name in [#dname v] where #loc v = \"CHICAGO\" where dno = 30 yield {dno = #deptno v, name = #dname v}"
>   : string

(* testFromSuchThat2d4 - Forward references with inequality constraint *)
from dno, name, v
where v elem scott.depts
where v.deptno = dno
where name = v.dname
