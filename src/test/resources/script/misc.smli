(* -------------------------------------------------------------------
 * [MOREL-251] Add function `Sys.clearEnv ()`
 *
 * This test needs an empty environment, so must be the first
 * test in the script.
 *)

(*) Number of values in initial environment.
val eLen = List.length (Sys.env());
> val eLen = 183 : int

(*) Now we have one more (due to "eLen").
List.length (Sys.env()) - eLen;
> val it = 1 : int
(*) And one more (due to "it").
List.length (Sys.env()) - eLen;
> val it = 2 : int
List.last (Sys.env());
> val it = ("vector","forall 'a. 'a list -> 'a vector") : string * string

(*) Define 3 variables.
val (x,y,z) = (1,2,3);
> val x = 1 : int
> val y = 2 : int
> val z = 3 : int
List.length (Sys.env()) - eLen;
> val it = 5 : int
List.last (Sys.env());
> val it = ("z","int") : string * string

(*) Overwrite one value, add another.
val (w,z) = ("four","five");
> val w = "four" : string
> val z = "five" : string
List.length (Sys.env()) - eLen;
> val it = 6 : int
List.last (Sys.env());
> val it = ("z","string") : string * string

(*) Clear the environment.
Sys.clearEnv();
> val it = () : unit
(*) Back down to the original eLen plus one (for "it").
List.length (Sys.env());
> val it = 184 : int
List.last (Sys.env());
> val it = ("vector","forall 'a. 'a list -> 'a vector") : string * string

(* -------------------------------------------------------------------
 * Setting properties whose values are enums
 *)
Sys.set ("output", "classic");
> val it = () : unit
Sys.set ("output", "CLASSIC");
> val it = () : unit
Sys.set ("output", "ClasSic");
> val it = () : unit
Sys.set ("output", "classic ");
> uncaught exception Fail [Fail: value for property 'output' must be one of: 'CLASSIC', 'TABULAR']
>   raised at: stdIn:1.1-1.31
Sys.set ("output", "bad");
> uncaught exception Fail [Fail: value for property 'output' must be one of: 'CLASSIC', 'TABULAR']
>   raised at: stdIn:1.1-1.26

(*) After you unset a property with a default value, it reverts to the default.
Sys.unset "output";
> val it = () : unit
Sys.show "output";
> val it = SOME "CLASSIC" : string option

(*) After you unset a property with a default value, it reverts to the default.
Sys.show "optionalInt";
> val it = NONE : string option
Sys.set ("optionalInt", "foo");
> uncaught exception Fail [Fail: value for property 'optionalInt' must have type 'int']
>   raised at: stdIn:1.1-1.31
Sys.set ("optionalInt", 12);
> val it = () : unit
Sys.show "optionalInt";
> val it = SOME "12" : string option
Sys.unset "optionalInt";
> val it = () : unit
Sys.show "optionalInt";
> val it = NONE : string option

(* A value of the wrong type is refused, and the message names the property
 * and the Morel type the property will take. It does not name the value it
 * rejected, nor any Java type. *)
Sys.set ("hybrid", 1);
> uncaught exception Fail [Fail: value for property 'hybrid' must have type 'bool']
>   raised at: stdIn:1.1-1.22
Sys.set ("scriptDirectory", true);
> uncaught exception Fail [Fail: value for property 'scriptDirectory' must have type 'file']
>   raised at: stdIn:1.1-1.34
Sys.set ("now", 0);
> uncaught exception Fail [Fail: value for property 'now' must have type 'string']
>   raised at: stdIn:1.1-1.19

(* "rangeMaxLength" takes an "IntInf.int": an "int", or a numeral in a
 * string where the value does not fit one. A string that is not a numeral
 * is refused like any other wrong value. *)
Sys.set ("rangeMaxLength", "4722366482869645213696");
> val it = () : unit
Sys.set ("rangeMaxLength", "banana");
> uncaught exception Fail [Fail: value for property 'rangeMaxLength' must have type 'IntInf.int']
>   raised at: stdIn:1.1-1.37
Sys.set ("rangeMaxLength", true);
> uncaught exception Fail [Fail: value for property 'rangeMaxLength' must have type 'IntInf.int']
>   raised at: stdIn:1.1-1.33
Sys.unset "rangeMaxLength";
> val it = () : unit

(*) Setting the "output" property is case-insensitive
Sys.set ("output", "classic");
> val it = () : unit
Sys.set ("output", "CLASSIC");
> val it = () : unit
Sys.set ("output", "ClasSic");
> val it = () : unit
Sys.set ("output", "tabular");
> val it = () : unit
Sys.set ("output", "classic");
> val it = () : unit

(* -------------------------------------------------------------------
 * Bug gave 'AssertionError: op not handled: EQ'
 *)
from p in (from p in [{a=1,b=2}] where p.a = 1);
> val it = [{a=1,b=2}] : {a:int, b:int} list

(* -------------------------------------------------------------------
 * [MOREL-250] Inliner generates invalid plan if dead code
 * occurs in a nested let.
 *)
let
  val bind = fn x => [x]
in
  let
    val three = 1 + 2
  in
    bind "a"
  end
end;
> val it = ["a"] : string list

(* -------------------------------------------------------------------
 * Floating point is not associative.
 *)
let
  val x = 1e30
  val y = ~1e30
  val z = 1.0
in
  ((x + y) + z, x + (y + z))
end;
> val it = (1,0) : real * real

(* -------------------------------------------------------------------
 * [MOREL-311] op
 *)
foldl (op +) 0 [2,3,4];
> val it = 9 : int
foldl (op +) 0.0 [2.0,3.5,4.5];
> val it = 10 : real
op +;
> val it = fn : int * int -> int
op *;
> val it = fn : int * int -> int
op ~;
> val it = fn : int -> int
op div;
> val it = fn : int * int -> int
op /;
> val it = fn : real * real -> real
op x;
> stdIn:1.1-1.5 Error: unbound variable or constructor: op x
>   raised at: stdIn:1.1-1.5
(* TODO sml-nj allows "op SOME" and "op NONE"; should Morel?
op SOME;
> val it = fn : 'a -> 'a option
op NONE;
> val it = NONE : 'a option
*)
(op ~) o (op ~);
> val it = fn : int -> int
it 5;
> val it = 5 : int
op ~ o op ~ o op ~;
> val it = fn : int -> int
it 5;
> val it = ~5 : int
(op *) (8,3);
> val it = 24 : int
(op +) (3,4);
> val it = 7 : int
(op /) (6.0, 4.0);
> val it = 1.5 : real
(op ^) ("foo","bar");
> val it = "foobar" : string
(op ::) (1,[2,3,4]);
> val it = [1,2,3,4] : int list
(op @) ([1,2],[3,4]);
> val it = [1,2,3,4] : int list

(* Error messages ----------------------------------------------------
 * Unbound-variable errors include the source position.
 * Single-character identifiers produce a single-column position;
 * longer identifiers produce * a column range.
 *)
val x = z;
> stdIn:1.9 Error: unbound variable or constructor: z
>   raised at: stdIn:1.9
val x = abc;
> stdIn:1.9-1.12 Error: unbound variable or constructor: abc
>   raised at: stdIn:1.9-1.12

(*) Nested block comments ([MOREL-306])
(* outer (* inner *) still outer *) 1 + 2;
> val it = 3 : int

(* -------------------------------------------------------------------
 * [MOREL-342] Conditional inclusion of built-in structures
 *)

(*) By default, the Test structure is excluded.
Test.foo 1;
> stdIn:1.1-1.5 Error: unbound variable or constructor: Test
>   raised at: stdIn:1.1-1.5

(*) After setting excludeStructures to "", Test is visible.
Sys.set ("excludeStructures", "");
> val it = () : unit
Sys.clearEnv ();
> val it = () : unit
Test.foo 1;
> val it = 2 : int

(*) After unsetting excludeStructures, Test is excluded again.
Sys.unset "excludeStructures";
> val it = () : unit
Sys.clearEnv ();
> val it = () : unit
Test.foo 1;
> stdIn:1.1-1.5 Error: unbound variable or constructor: Test
>   raised at: stdIn:1.1-1.5

(* -------------------------------------------------------------------
 * A "let" body can use earlier declarations of the same "let".
 *)
let val x = 1 in x end;
> val it = 1 : int
let val x = 1 val y = x in y end;
> val it = 1 : int
let val s = "morel" in size s end;
> val it = 5 : int

(* -------------------------------------------------------------------
 * "val rec", top-level and in "let", singly and mutually recursive.
 *)
val rec r = fn 0 => 1 | _ => r 0;
> val r = fn : int -> int
r 9;
> val it = 1 : int
let val rec g = fn 0 => 2 | _ => g 0 in g 7 end;
> val it = 2 : int
let val rec fm = fn () => gm 0 and gm = fn 0 => 6 | _ => fm () in fm () end;
> val it = 6 : int

(*) End misc.smli
